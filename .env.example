# 只复制需要启用的部分到 .env；不要提交真实密钥。

# MasterGo 官方 MCP
MG_MCP_TOKEN=
MASTERGO_API_BASE_URL=https://mastergo.com
# 可选：登记常用设计文件，提问时说名称即可；格式 名称=链接，多个用英文分号分隔
# XUNJI_MASTERGO_FILES=商城后台=https://mastergo.com/file/xxx;官网=https://mastergo.com/file/yyy

# 飞书官方 OpenAPI MCP
LARK_APP_ID=
LARK_APP_SECRET=
# 文档和 Wiki 工具白名单固定在 Profile 内，不能通过环境变量放宽。

# Confluence Server / Data Center 7.1
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SSL_VERIFY=true

# 可选：本机历史归档（可填 codex、claude 或 codex,claude；仅建立只读索引）
# XUNJI_CONVERSATION_ARCHIVE=codex,claude

# 可选：飞书对话导入（填 on 启用；只读取放入 .dsh/imports 的导出文件，不连接飞书）
# XUNJI_CHAT_IMPORT=on

# 可选：把 DSH 数据放到其他目录；默认使用项目内 .dsh
# XUNJI_DSH_HOME=
