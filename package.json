{
  "name": "xunji-dsh",
  "version": "0.1.0",
  "private": true,
  "description": "基于 DeepSeek Harness 的轻量私人开发工作台",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "setup": "npm run workbench:build && node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "dsh": "node scripts/dsh.mjs",
    "doctor": "node scripts/doctor.mjs",
    "workbench:build": "npm --prefix plugins/xunji-workbench run bundle",
    "workbench:typecheck": "npm --prefix plugins/xunji-workbench run typecheck",
    "package": "npm run workbench:build && node scripts/package-app.mjs",
    "package:installer": "node scripts/package-installer.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run doctor && npm run workbench:typecheck && npm run workbench:build && npm test"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "pnpm": "11.21.0"
  }
}
